{
  "name": "toolhive-studio",
  "productName": "ToolHive",
  "version": "0.0.0-dev",
  "description": "ToolHive is an application that allows you to install, manage and run MCP servers and connect them to AI agents and clients",
  "main": ".vite/build/main.cjs",
  "repository": "https://github.com/stacklok/toolhive-studio",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:inspect": "tsx scripts/start-inspect.ts",
    "start:customTheme": "tsx scripts/start-custom-theme.ts",
    "e2e": "pnpm package && pnpm e2e:prebuilt",
    "e2e:prebuilt": "playwright test",
    "package": "node scripts/tsc-native.mjs -b --clean && node scripts/tsc-native.mjs -b && electron-forge package",
    "make": "node scripts/tsc-native.mjs -b --clean && node scripts/tsc-native.mjs -b && electron-forge make",
    "prettier": "prettier . --check",
    "format": "prettier . --write",
    "lint": "eslint .",
    "publish": "electron-forge release",
    "type-check": "node scripts/tsc-native.mjs --noEmit -p ./tsconfig.app.json && node scripts/tsc-native.mjs --noEmit -p ./tsconfig.node.json",
    "prepare": "husky install",
    "thv": "rimraf bin/ && tsx ./utils/fetch-thv.ts --run",
    "vitest:electron": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test": "pnpm run vitest:electron",
    "test:nonInteractive": "pnpm run vitest:electron run",
    "test:coverage": "pnpm run vitest:electron run --coverage",
    "update-api": "tsx scripts/update-api.ts",
    "generate-client": "pnpm run update-api && cd common/api && openapi-ts",
    "generate-client:nofetch": "cd common/api && openapi-ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "knip": "knip",
    "deeplink:registerTestLinuxProtocolHandler": "bash scripts/install-deep-link-handler.sh",
    "devContainer:dev": "bash scripts/devcontainer-dev.sh"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-base": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/publisher-s3": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/regexp.escape": "^2.0.0",
    "@types/semver": "^7.8.0",
    "@types/unzipper": "^0.10.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "electron": "45.2.3",
    "electron-winstaller": "^5.4.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "icon-gen": "^5.0.0",
    "jsdom": "^31.0.0",
    "json-schema-faker": "^0.6.4",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "memfs": "^4.80.0",
    "msw": "^3.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-classnames": "^0.10.5",
    "prettier-plugin-merge": "^0.10.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.4",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "unzipper": "^0.12.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-fail-on-console": "^0.10.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
